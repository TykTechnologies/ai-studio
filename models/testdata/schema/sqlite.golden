  constraint CONSTRAINT `fk_tool_catalogue_mcp_servers_mcp_server` FOREIGN KEY (`mcp_server_id`) REFERENCES `mcp_servers`(`id`)
  constraint CONSTRAINT `fk_tool_catalogue_mcp_servers_tool_catalogue` FOREIGN KEY (`tool_catalogue_id`) REFERENCES `tool_catalogues`(`id`)
  constraint PRIMARY KEY (`mcp_server_id`,`tool_catalogue_id`)
  autoindex origin=pk unique=1 (mcp_server_id, tool_catalogue_id)
TABLE tool_catalogue_tags
  column `tool_catalogue_id` integer
  column `tag_id` integer
  constraint CONSTRAINT `fk_tool_catalogue_tags_tag` FOREIGN KEY (`tag_id`) REFERENCES `tags`(`id`)
  constraint CONSTRAINT `fk_tool_catalogue_tags_tool_catalogue` FOREIGN KEY (`tool_catalogue_id`) REFERENCES `tool_catalogues`(`id`)
  constraint PRIMARY KEY (`tool_catalogue_id`,`tag_id`)
  autoindex origin=pk unique=1 (tool_catalogue_id, tag_id)
TABLE tool_catalogue_tools
  column `tool_catalogue_id` integer
  column `tool_id` integer
  constraint CONSTRAINT `fk_tool_catalogue_tools_tool_catalogue` FOREIGN KEY (`tool_catalogue_id`) REFERENCES `tool_catalogues`(`id`)
  constraint CONSTRAINT `fk_tool_catalogue_tools_tool` FOREIGN KEY (`tool_id`) REFERENCES `tools`(`id`)
  constraint PRIMARY KEY (`tool_catalogue_id`,`tool_id`)
  autoindex origin=pk unique=1 (tool_catalogue_id, tool_id)
TABLE tool_catalogues
  column `id` integer PRIMARY KEY AUTOINCREMENT
