  constraint CONSTRAINT `fk_tool_dependencies_tool` FOREIGN KEY (`tool_id`) REFERENCES `tools`(`id`)
  constraint PRIMARY KEY (`tool_id`,`dependency_id`)
  autoindex origin=pk unique=1 (tool_id, dependency_id)
TABLE tool_filestores
  column `tool_id` integer
