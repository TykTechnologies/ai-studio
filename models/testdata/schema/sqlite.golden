TABLE access_tokens
  column `id` integer PRIMARY KEY AUTOINCREMENT
  column `created_at` datetime
  column `updated_at` datetime
  column `deleted_at` datetime
  column `token` varchar(255) NOT NULL
  column `client_id` varchar(255) NOT NULL
  column `user_id` integer NOT NULL
  column `scope` varchar(255)
  column `expires_at` datetime NOT NULL
  column `app_id` integer
  index CREATE INDEX `idx_access_tokens_app_id` ON `access_tokens`(`app_id`)
  index CREATE INDEX `idx_access_tokens_deleted_at` ON `access_tokens`(`deleted_at`)
  index CREATE UNIQUE INDEX `idx_access_tokens_token` ON `access_tokens`(`token`)
TABLE agent_configs
  column `id` integer PRIMARY KEY AUTOINCREMENT
  column `created_at` datetime
  column `updated_at` datetime
  column `deleted_at` datetime
  column `name` text NOT NULL
  column `slug` text NOT NULL
  column `description` text
  column `plugin_id` integer NOT NULL
  column `app_id` integer NOT NULL
  column `config` text
  column `is_active` numeric DEFAULT true
  column `namespace` text DEFAULT ""
  constraint CONSTRAINT `fk_agent_configs_app` FOREIGN KEY (`app_id`) REFERENCES `apps`(`id`)
  constraint CONSTRAINT `fk_agent_configs_plugin` FOREIGN KEY (`plugin_id`) REFERENCES `plugins`(`id`)
  index CREATE INDEX `idx_agent_app` ON `agent_configs`(`app_id`)
  index CREATE INDEX `idx_agent_configs_deleted_at` ON `agent_configs`(`deleted_at`)
  index CREATE INDEX `idx_agent_is_active` ON `agent_configs`(`is_active`)
  index CREATE INDEX `idx_agent_namespace` ON `agent_configs`(`namespace`)
  index CREATE INDEX `idx_agent_plugin` ON `agent_configs`(`plugin_id`)
  index CREATE UNIQUE INDEX `idx_agent_configs_slug` ON `agent_configs`(`slug`)
TABLE agent_groups
  column `agent_config_id` integer
  column `group_id` integer
  constraint CONSTRAINT `fk_agent_groups_agent_config` FOREIGN KEY (`agent_config_id`) REFERENCES `agent_configs`(`id`)
  constraint CONSTRAINT `fk_agent_groups_group` FOREIGN KEY (`group_id`) REFERENCES `groups`(`id`)
  constraint PRIMARY KEY (`agent_config_id`,`group_id`)
  autoindex origin=pk unique=1 (agent_config_id, group_id)
TABLE app_datasources
  column `app_id` integer
