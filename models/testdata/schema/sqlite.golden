TABLE webhook_deliveries
  column `id` text
  column `event_id` text
  column `target_id` text
  column `topic` text
  column `target_url_snapshot` text
  column `status` text
  column `attempt_count` integer
  column `max_attempts` integer
  column `next_attempt_at` datetime
  column `lease_owner` text
  column `lease_expires_at` datetime
  column `rendered_payload` text
  column `render_error` text
  column `last_status_code` integer
  column `last_error` text
  column `last_response_snippet` text
  column `replay_of_id` text
  column `kind` text
  column `dedupe_key` text
  column `lock_version` integer NOT NULL DEFAULT 0
  column `created_at` datetime
  column `completed_at` datetime
  column `updated_at` datetime
  constraint PRIMARY KEY (`id`)
  autoindex origin=pk unique=1 (id)
  index CREATE INDEX `idx_webhook_deliveries_created` ON `webhook_deliveries`(`created_at`)
  index CREATE INDEX `idx_webhook_deliveries_event` ON `webhook_deliveries`(`event_id`)
