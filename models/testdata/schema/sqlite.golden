  index CREATE INDEX `idx_webhook_deliveries_replay_of` ON `webhook_deliveries`(`replay_of_id`)
  index CREATE INDEX `idx_webhook_deliveries_status_next` ON `webhook_deliveries`(`status`,`next_attempt_at`)
  index CREATE INDEX `idx_webhook_deliveries_target_created` ON `webhook_deliveries`(`target_id`,`created_at`)
  index CREATE INDEX `idx_webhook_deliveries_topic_created` ON `webhook_deliveries`(`topic`,`created_at`)
  index CREATE UNIQUE INDEX `uq_webhook_deliveries_dedupe` ON `webhook_deliveries`(`dedupe_key`)
TABLE webhook_delivery_attempts
  column `id` integer PRIMARY KEY AUTOINCREMENT
  column `delivery_id` text
