  column updated_at timestamp with time zone(timestamptz) nullable=YES
  column deleted_at timestamp with time zone(timestamptz) nullable=YES
  column name text(text) nullable=NO
  column slug text(text) nullable=NO
  column description text(text) nullable=YES
  column plugin_id bigint(int8) nullable=NO precision=64 scale=0
  column app_id bigint(int8) nullable=NO precision=64 scale=0
  column config text(text) nullable=YES
  column is_active boolean(bool) nullable=YES default=true
  column namespace text(text) nullable=YES default=''::text
