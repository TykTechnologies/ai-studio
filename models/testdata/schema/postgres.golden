TABLE audit_records
  constraint audit_records_pkey PRIMARY KEY (id)
  index CREATE UNIQUE INDEX audit_records_pkey ON audit_records USING btree (id)
  index CREATE INDEX idx_audit_action ON audit_records USING btree (action)
  index CREATE INDEX idx_audit_auth_method ON audit_records USING btree (auth_method)
  index CREATE INDEX idx_audit_ip ON audit_records USING btree (ip)
  index CREATE INDEX idx_audit_method ON audit_records USING btree (method)
  index CREATE INDEX idx_audit_req_id ON audit_records USING btree (request_id)
  index CREATE INDEX idx_audit_resource ON audit_records USING btree (resource_type, resource_id)
  index CREATE INDEX idx_audit_route ON audit_records USING btree (route)
  index CREATE INDEX idx_audit_status ON audit_records USING btree (status)
  index CREATE INDEX idx_audit_ts ON audit_records USING btree ("timestamp")
  index CREATE INDEX idx_audit_user_email ON audit_records USING btree (user_email)
  index CREATE INDEX idx_audit_user_id ON audit_records USING btree (user_id)
  column id bigint(int8) nullable=NO precision=64 scale=0 default=nextval('audit_records_id_seq'::regclass)
  column request_id character varying(varchar) nullable=YES len=64
  column timestamp timestamp with time zone(timestamptz) nullable=YES
  column ip character varying(varchar) nullable=YES len=64
  column user_id bigint(int8) nullable=YES precision=64 scale=0
  column user_email character varying(varchar) nullable=YES len=255
  column user_name character varying(varchar) nullable=YES len=255
  column user_agent character varying(varchar) nullable=YES len=512
  column auth_method character varying(varchar) nullable=YES len=16
  column action character varying(varchar) nullable=YES len=128
  column method character varying(varchar) nullable=YES len=16
  column url character varying(varchar) nullable=YES len=2048
  column route character varying(varchar) nullable=YES len=255
  column status bigint(int8) nullable=YES precision=64 scale=0
  column resource_type character varying(varchar) nullable=YES len=64
  column resource_id character varying(varchar) nullable=YES len=255
  column resource_name character varying(varchar) nullable=YES len=255
  column diff text(text) nullable=YES
  column request_dump text(text) nullable=YES
  column response_dump text(text) nullable=YES
  column error character varying(varchar) nullable=YES len=1024
  column duration_ms bigint(int8) nullable=YES precision=64 scale=0
