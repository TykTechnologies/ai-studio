# FIPS 140-3 AI Studio image (tykio/tyk-ai-studio-fips): the -fips package
# (GOFIPS140=v1.0.0, Go Cryptographic Module v1.0.0, CMVP #5247) on Tyk's
# FIPS base, as tyk-gateway-fips uses. The base is a Debian 13 glibc image
# (the cgo SQLite driver needs glibc; /lib64/ld-linux-x86-64.so.2 is there)
# running as uid 65532, like distroless :nonroot.
FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a as DEB
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive

COPY *${TARGETARCH}.deb /
RUN dpkg -i /tyk-ai-studio-fips*${TARGETARCH}.deb && rm /*.deb

FROM tykio/dhi-busybox:1.37-fips@sha256:f3600a497e38b3cd381bc41df15a84438b3e1ab7ba0feeb0d0f3f17189ee256e

COPY --from=DEB /opt/tyk-ai-studio /opt/tyk-ai-studio

ARG PORTS
EXPOSE $PORTS

WORKDIR /opt/tyk-ai-studio/

ENTRYPOINT ["/opt/tyk-ai-studio/tyk-ai-studio" ]
CMD [ "-env=/opt/tyk-ai-studio/.env" ]
