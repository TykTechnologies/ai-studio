# ---------------------------------------------------------------------------
# Live vendor conformance test credentials
# ---------------------------------------------------------------------------
# Copy to test-secrets/vendors.env and fill in. That file is gitignored.
#
#   cp test-secrets/vendors.env.example test-secrets/vendors.env
#   make test-vendors
#
# The Go harness loads test-secrets/vendors.env itself (godotenv), so you do
# NOT need to source it in your shell. To point at a different file:
#   VENDOR_TESTS_ENV_FILE=/path/to/other.env make test-vendors
#
# A vendor whose *required* variables are blank is SKIPPED, not failed. Fill in
# only the vendors you can reach. Every skip is printed in the run summary.
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. Suite-level switches (no secrets)
# ===========================================================================

# Master switch. The suite ALSO requires `-tags vendorlive`, so it can never be
# picked up by `go test ./...` or CI by accident.
VENDOR_TESTS_ENABLED=true

# Which vendors to exercise. Empty = every vendor that has credentials.
# Valid: openai,anthropic,google_ai,vertex,bedrock,ollama,huggingface
VENDOR_TESTS_VENDORS=

# Which ingress surfaces to exercise. Empty = all four.
#   chat      - Studio chat session (langchaingo driver path)
#   shim      - /ai/{slug}/v1/chat/completions   (OpenAI-format translation)
#   sdk       - /llm/call/{slug}/...             (native vendor passthrough)
#   universal - /v1/chat/completions             (OpenRouter-style vendor/model)
VENDOR_TESTS_SURFACES=

# Which scenarios to run. Empty = all. See features/VendorConformance.md.
# basic,streaming,multiturn,system,tools,tools_streaming,json_mode,vision,
# long_context,errors,usage
VENDOR_TESTS_SCENARIOS=

# Run both the latest and the latest-1 model family (default true).
# Set false to only exercise MODEL_LATEST and halve the spend.
VENDOR_TESTS_INCLUDE_PREV_MODEL=true

# Fail (rather than record a drift report) when a vendor response contains a
# field the canonical schema does not describe. Start false; flip to true once
# the drift report is clean, to lock the contract down.
VENDOR_TESTS_STRICT_UNKNOWN_FIELDS=false

# Rewrite the golden normalized-envelope snapshots instead of comparing.
VENDOR_TESTS_UPDATE_GOLDEN=false

# Per-request budget guards.
VENDOR_TESTS_MAX_TOKENS=256
VENDOR_TESTS_TIMEOUT=120s
VENDOR_TESTS_PARALLEL=4

# Where schema-violation dumps, drift reports and the conformance matrix land.
VENDOR_TESTS_ARTIFACT_DIR=./test-results/vendor-conformance

# Optional: run against an already-running stack instead of booting Studio and
# the microgateway in-process. Leave BOTH blank for the default in-process mode.
VENDOR_TESTS_STUDIO_BASE_URL=
VENDOR_TESTS_MICROGATEWAY_BASE_URL=
# API token to use when the URLs above are set (in-process mode mints its own).
VENDOR_TESTS_API_TOKEN=


# ===========================================================================
# 2. OpenAI
# ===========================================================================
# Required: API_KEY, MODEL_LATEST
VT_OPENAI_API_KEY=
# Base URL. Must include /v1 - the OpenAI SDK appends /chat/completions to it,
# and the native-passthrough surface appends chat/completions.
VT_OPENAI_ENDPOINT=https://api.openai.com/v1
# Current generation chat model, e.g. the newest gpt-* family member.
VT_OPENAI_MODEL_LATEST=
# Previous generation (latest-1) chat model.
VT_OPENAI_MODEL_PREV=
# Optional: a reasoning-family model. Its usage object carries extra fields
# (reasoning tokens) and it rejects some sampling params - the suite asserts
# that our translation layer handles both.
VT_OPENAI_MODEL_REASONING=
# Optional: vision-capable model for the multimodal scenario.
VT_OPENAI_MODEL_VISION=


# ===========================================================================
# 3. Anthropic
# ===========================================================================
# Required: API_KEY, MODEL_LATEST
VT_ANTHROPIC_API_KEY=
# Base URL - MUST include /v1. Counter-intuitive but correct: the driver is
# langchaingo's anthropicclient, whose DefaultBaseURL is
# "https://api.anthropic.com/v1" and which appends only "/messages". Dropping the
# /v1 (as the official Anthropic SDK would want) produces
# https://api.anthropic.com/messages and a bare 404 with no explanation.
VT_ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1
VT_ANTHROPIC_MODEL_LATEST=
VT_ANTHROPIC_MODEL_PREV=
# anthropic-version header sent on the native-passthrough surface.
VT_ANTHROPIC_API_VERSION=2023-06-01
# Optional: extra beta headers, comma separated (e.g. "context-1m-2025-08-07").
VT_ANTHROPIC_BETA_HEADERS=


# ===========================================================================
# 4. Google AI (Gemini Developer API)
# ===========================================================================
# Required: API_KEY, MODEL_LATEST
VT_GOOGLEAI_API_KEY=
VT_GOOGLEAI_ENDPOINT=https://generativelanguage.googleapis.com
VT_GOOGLEAI_MODEL_LATEST=
VT_GOOGLEAI_MODEL_PREV=
# API version segment used by the native-passthrough surface.
VT_GOOGLEAI_API_VERSION=v1beta


# ===========================================================================
# 5. Google Vertex AI
# ===========================================================================
# Required: PROJECT, LOCATION, CREDENTIALS_FILE, MODEL_LATEST
# The LLM config's APIEndpoint is built as "<project>:<location>" - that is the
# format vendors/vertex/vertex.go parses.
VT_VERTEX_PROJECT=
VT_VERTEX_LOCATION=us-central1
# Absolute path to a service-account JSON key. The harness exports this as
# GOOGLE_APPLICATION_CREDENTIALS for the duration of the run.
VT_VERTEX_CREDENTIALS_FILE=
VT_VERTEX_MODEL_LATEST=
VT_VERTEX_MODEL_PREV=


# ===========================================================================
# 6. AWS Bedrock
# ===========================================================================
# Required: ACCESS_KEY_ID, SECRET_ACCESS_KEY, REGION, MODEL_LATEST
# Credentials land in LLM.Metadata as aws_access_key_id / aws_secret_access_key
# / aws_session_token, which is where vendors/bedrock/bedrock.go reads them.
VT_BEDROCK_ACCESS_KEY_ID=
VT_BEDROCK_SECRET_ACCESS_KEY=
# Optional - only for temporary STS credentials.
VT_BEDROCK_SESSION_TOKEN=
# NOTE: when ENDPOINT is set, vendors/bedrock/bedrock.go derives the real region
# from the endpoint HOSTNAME and ignores this value. The harness errors out on a
# mismatch rather than letting a dead setting look effective.
VT_BEDROCK_REGION=us-east-1
# Optional endpoint override. Blank => https://bedrock-runtime.<region>.amazonaws.com
# Cross-region inference: https://bedrock-mantle.<region>.api.aws  (a trailing
# /v1 is accepted and stripped by the vendor client).
VT_BEDROCK_ENDPOINT=
# Model / inference-profile IDs, e.g. an "<region>.anthropic.claude-*" profile.
VT_BEDROCK_MODEL_LATEST=
VT_BEDROCK_MODEL_PREV=
# Model used for the /anthropic/{slug}/v1/messages native bridge (Claude Code
# path). Usually the same as MODEL_LATEST. Blank => that bridge is skipped.
VT_BEDROCK_ANTHROPIC_MODEL=


# ===========================================================================
# 7. Ollama (self-hosted, OpenAI-compatible)
# ===========================================================================
# Required: ENDPOINT, MODEL_LATEST
VT_OLLAMA_ENDPOINT=http://localhost:11434
VT_OLLAMA_MODEL_LATEST=
VT_OLLAMA_MODEL_PREV=


# ===========================================================================
# 8. Hugging Face Inference
# ===========================================================================
# Required: API_KEY, ENDPOINT, MODEL_LATEST
VT_HUGGINGFACE_API_KEY=
VT_HUGGINGFACE_ENDPOINT=https://router.huggingface.co
VT_HUGGINGFACE_MODEL_LATEST=
VT_HUGGINGFACE_MODEL_PREV=


# ===========================================================================
# 9. OpenAI-compatible third parties (optional, repeatable)
# ===========================================================================
# Any OpenAI-wire-compatible provider (Azure OpenAI, Groq, Together, vLLM,
# LiteLLM...). Registered as vendor "openai" with a custom endpoint. Add more
# by incrementing the index; the harness scans until it finds a blank NAME.
VT_COMPAT_1_NAME=
VT_COMPAT_1_ENDPOINT=
VT_COMPAT_1_API_KEY=
VT_COMPAT_1_MODEL_LATEST=
VT_COMPAT_1_MODEL_PREV=


# ===========================================================================
# 10. Guardrail providers  (make test-guardrails)
# ===========================================================================
# Drives each guardrail provider against its real service with canonical
# probes (benign, prompt injection, PII, credential), then attaches them as
# guardrail filters to the first configured vendor above and hits the /ai/
# shim. The built-in pattern library always runs and needs nothing here.
# A provider with blank required variables is SKIPPED with a reason.
#
# Which providers to exercise. Empty = every provider that has credentials.
# Valid: builtin,lakera,azure_cs,azure_pii,presidio,bedrock,http
VENDOR_TESTS_GUARDRAILS=

# --- Lakera Guard v2 -------------------------------------------------------
# Required: API_KEY (SaaS) or ENDPOINT (self-hosted Guard, which needs no key).
# The project's policy must have the Prompt Attack detector on; PII on for the
# PII probe to be asserted (set EXPECT_PII=false if the policy has PII off).
VT_GUARD_LAKERA_API_KEY=
# Blank => https://api.lakera.ai/v2/guard. EU: https://eu.api.lakera.ai/v2/guard
VT_GUARD_LAKERA_ENDPOINT=
VT_GUARD_LAKERA_PROJECT_ID=
VT_GUARD_LAKERA_EXPECT_PII=true

# --- Azure AI Content Safety ----------------------------------------------
# Required: ENDPOINT, API_KEY. A Content Safety (or multi-service) resource in
# a region that offers Prompt Shields; the F0 tier is enough (5 RPS).
VT_GUARD_AZURE_CS_ENDPOINT=https://<resource>.cognitiveservices.azure.com
VT_GUARD_AZURE_CS_API_KEY=
# Optional: comma-separated blocklist names to apply.
VT_GUARD_AZURE_CS_BLOCKLISTS=

# --- Azure AI Language (PII detection) -------------------------------------
# Required: ENDPOINT, API_KEY. A Language (or multi-service) resource; the
# Text PII container also works with its own endpoint.
VT_GUARD_AZURE_PII_ENDPOINT=https://<resource>.cognitiveservices.azure.com
VT_GUARD_AZURE_PII_API_KEY=
VT_GUARD_AZURE_PII_LANGUAGE=en

# --- Microsoft Presidio (self-hosted, no credentials) ----------------------
# Required: ANALYZER_URL. e.g. docker run -p 5002:3000 mcr.microsoft.com/presidio-analyzer
VT_GUARD_PRESIDIO_ANALYZER_URL=
# Optional: docker run -p 5001:3000 mcr.microsoft.com/presidio-anonymizer
VT_GUARD_PRESIDIO_ANONYMIZER_URL=
VT_GUARD_PRESIDIO_LANGUAGE=en

# --- Amazon Bedrock Guardrails --------------------------------------------
# Required: GUARDRAIL_ID, plus REGION and AWS credentials, which fall back to
# the VT_BEDROCK_* values in section 6. The guardrail should have the Prompt
# Attack content filter and a PII entity (EMAIL, PHONE) set to Anonymize so
# both probes can be asserted; otherwise set the EXPECT_* switches to false.
VT_GUARD_BEDROCK_GUARDRAIL_ID=
VT_GUARD_BEDROCK_GUARDRAIL_VERSION=DRAFT
VT_GUARD_BEDROCK_REGION=
VT_GUARD_BEDROCK_ACCESS_KEY_ID=
VT_GUARD_BEDROCK_SECRET_ACCESS_KEY=
VT_GUARD_BEDROCK_EXPECT_INJECTION=true
VT_GUARD_BEDROCK_EXPECT_PII=true

# --- Generic HTTP classifier (self-hosted, e.g. Prompt Guard 2 / LLM Guard) --
# Required: ENDPOINT. The service speaks the contract in docs/site/docs/guardrails.md.
VT_GUARD_HTTP_ENDPOINT=
VT_GUARD_HTTP_API_KEY=
VT_GUARD_HTTP_AUTH_HEADER=
# Detector names the service defines; prompt_attack/injection/jailbreak enable
# the injection assertion, pii the PII assertion.
VT_GUARD_HTTP_DETECTORS=prompt_attack
VT_GUARD_HTTP_REDACTS=false
