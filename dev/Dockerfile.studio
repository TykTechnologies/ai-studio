# Development Dockerfile for AI Studio
# Supports both CE and ENT editions via build args
#
# Usage:
#   docker build -f dev/Dockerfile.studio -t midsommar-studio-dev .
#   docker build -f dev/Dockerfile.studio --build-arg EDITION=ent -t midsommar-studio-dev-ent .

FROM golang:1.26-bookworm@sha256:e8c859f5632dcfde7b32d2012b4351728f6437930887c2f6a91ea242459e5514 AS base

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    screen \
    wget \
    curl \
    gcc \
    g++ \
    build-essential \
    sqlite3 \
    libsqlite3-dev \
    inotify-tools \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20 LTS
# SECURITY: curl|bash pattern - pinned to nodesource setup script; verify integrity before updating
RUN curl -fsSL https://deb.nodesource.com/setup_20.x -o /tmp/nodesource_setup.sh \
    && bash /tmp/nodesource_setup.sh \
    && apt-get install -y nodejs \
    && rm -f /tmp/nodesource_setup.sh \
    && rm -rf /var/lib/apt/lists/*

# Install Air for Go hot reloading (pinned to v1.61.7)
RUN go install github.com/air-verse/air@v1.61.7

# Install cosign for OCI plugin signature verification (pinned to v2.4.1)
RUN curl -fsSL https://github.com/sigstore/cosign/releases/download/v2.4.1/cosign-linux-$(dpkg --print-architecture) -o /usr/local/bin/cosign \
    && chmod +x /usr/local/bin/cosign

# Set working directory
WORKDIR /app

# Clone langchaingo fork (required dependency)
RUN git clone --depth 1 https://github.com/lonelycode/langchaingo /langchaingo

# Create required directories
RUN mkdir -p /app/bin /app/data /app/tmp

# Environment configuration
ENV GOPATH=/root/go
ENV PATH="${GOPATH}/bin:/usr/local/go/bin:${PATH}"
ENV CGO_ENABLED=1

# Build arguments for edition
ARG EDITION=ce
ENV EDITION=${EDITION}

# Set build tags based on edition
ENV BUILD_TAGS=""

# Expose ports
# 3000 - Frontend dev server (when running npm start)
# 8080 - Backend REST API
# 9090 - embedded gateway
# 50051 - gRPC Control Server
EXPOSE 3000 8080 9090 50051

# Default command uses Air for hot reloading
# Can be overridden in docker-compose
CMD ["air", "-c", "/app/dev/air/.air.studio.toml"]
