{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gemini_generate_content.json",
  "title": "Gemini generateContent response",
  "description": "Native Google AI wire format, seen on the sdk surface (/llm/call/{slug}/{version}/models/{model}:generateContent).",
  "type": "object",
  "required": ["candidates"],
  "properties": {
    "modelVersion": { "type": "string" },
    "responseId": { "type": "string" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "finishReason": {
            "type": ["string", "null"],
            "enum": ["STOP", "MAX_TOKENS", "SAFETY", "RECITATION", "LANGUAGE", "BLOCKLIST", "PROHIBITED_CONTENT", "SPII", "MALFORMED_FUNCTION_CALL", "IMAGE_SAFETY", "OTHER", "FINISH_REASON_UNSPECIFIED", null]
          },
          "safetyRatings": { "type": ["array", "null"] },
          "content": {
            "type": "object",
            "required": ["parts"],
            "properties": {
              "role": { "enum": ["model"] },
              "parts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": { "type": "string" },
                    "thought": { "type": "boolean" },
                    "thoughtSignature": {
                      "description": "Added upstream 2026-09. An opaque token that lets a follow-up turn resume the model's reasoning. Opaque to us and deliberately not carried into the OpenAI shape, which has nowhere to put it.",
                      "type": "string"
                    },
                    "functionCall": {
                      "type": "object",
                      "required": ["name", "args"],
                      "properties": {
                        "name": { "type": "string", "minLength": 1 },
                        "args": {
                          "description": "A decoded object, like Anthropic's input and unlike OpenAI's string.",
                          "type": "object"
                        }
                      }
                    },
                    "inlineData": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "promptFeedback": { "type": ["object", "null"] },
    "usageMetadata": {
      "type": ["object", "null"],
      "required": ["promptTokenCount", "totalTokenCount"],
      "properties": {
        "promptTokenCount": { "type": "integer", "minimum": 0 },
        "candidatesTokenCount": { "type": "integer", "minimum": 0 },
        "thoughtsTokenCount": { "type": "integer", "minimum": 0 },
        "cachedContentTokenCount": { "type": "integer", "minimum": 0 },
        "totalTokenCount": { "type": "integer", "minimum": 0 },
        "promptTokensDetails": {
          "description": "Added upstream 2026-09. Per-modality breakdown of promptTokenCount, which stays the billable total.",
          "type": ["array", "null"]
        },
        "candidatesTokensDetails": { "type": ["array", "null"] },
        "serviceTier": { "type": ["string", "null"] }
      }
    }
  }
}
