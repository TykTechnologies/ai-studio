# configs/.env.example

# Server Configuration
PORT=8080
HOST=0.0.0.0
TLS_ENABLED=false
TLS_CERT_PATH=/path/to/cert.pem
TLS_KEY_PATH=/path/to/key.pem
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s

# Database Configuration
# For PostgreSQL:
DATABASE_TYPE=postgres
DATABASE_DSN=postgres://user:password@localhost:5432/microgateway?sslmode=disable
# For SQLite:
# DATABASE_TYPE=sqlite
# DATABASE_DSN=file:./data/microgateway.db?mode=rwc

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_AUTO_MIGRATE=true
DB_LOG_LEVEL=warn

# Cache Configuration
CACHE_ENABLED=true
CACHE_MAX_SIZE=1000
CACHE_TTL=1h
CACHE_CLEANUP_INTERVAL=10m
CACHE_PERSIST_TO_DB=false

# Gateway Configuration
GATEWAY_TIMEOUT=5m
GATEWAY_MAX_REQUEST_SIZE=10485760
GATEWAY_MAX_RESPONSE_SIZE=52428800
GATEWAY_ENABLE_FILTERS=true
GATEWAY_ENABLE_ANALYTICS=true
# Unified OpenAI-compatible endpoint: {base}/chat/completions, {base}/completions,
# {base}/models. Move it when embedding behind a host that owns /v1, or disable it.
GATEWAY_UNIFIED_ROUTER_PATH=/v1
GATEWAY_UNIFIED_ROUTER_DISABLED=false
# Native API operations on /llm/call/{slug} (Anthropic Message Batches).
# GATEWAY_PUBLIC_URL is the absolute base of a batch's results_url (unset: relative).
# GATEWAY_PUBLIC_URL=https://edge.example.com
# NATIVE_API_MAX_BODY_BYTES=67108864        # batch create body limit (max 256 MiB)
# NATIVE_API_MAX_CONCURRENT_CREATES=4       # creates admitted at once
# NATIVE_API_MAX_FILTERED_ITEMS=10000       # requests per batch when the LLM has filters
# NATIVE_API_MAX_IN_PROGRESS_PER_APP=0      # 0 = no cap
# NATIVE_API_RECONCILE_INTERVAL=30s        # reconciler pass interval (accounts batches nobody downloads)
# NATIVE_API_RECONCILE_BATCH=50            # batches per reconciler pass
# NATIVE_API_RECONCILE_WORKERS=4           # batches reconciled at once
# NATIVE_API_POLL_INTERVAL=2m              # wait before polling an unfinished batch again
# NATIVE_API_POLL_MAX_BACKOFF=30m          # longest wait after failed polls

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_BUFFER_SIZE=1000
ANALYTICS_FLUSH_INTERVAL=10s
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_REALTIME=false

# Security Configuration
JWT_SECRET=your-secret-key-here
ENCRYPTION_KEY=your-32-byte-encryption-key-here
BCRYPT_COST=10
TOKEN_LENGTH=32
SESSION_TIMEOUT=24h
ENABLE_IP_WHITELIST=false

# Observability Configuration
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PATH=/metrics
ENABLE_TRACING=false
TRACING_ENDPOINT=http://localhost:14268/api/traces
ENABLE_PROFILING=false