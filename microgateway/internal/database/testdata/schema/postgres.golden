TABLE access_tokens
  constraint access_tokens_pkey PRIMARY KEY (id)
  index CREATE UNIQUE INDEX access_tokens_pkey ON access_tokens USING btree (id)
  index CREATE INDEX idx_access_tokens_app_id ON access_tokens USING btree (app_id)
  index CREATE INDEX idx_access_tokens_deleted_at ON access_tokens USING btree (deleted_at)
  index CREATE UNIQUE INDEX idx_access_tokens_token_hash ON access_tokens USING btree (token_hash)
  column id bigint(int8) nullable=NO precision=64 scale=0 default=nextval('access_tokens_id_seq'::regclass)
  column created_at timestamp with time zone(timestamptz) nullable=YES
  column updated_at timestamp with time zone(timestamptz) nullable=YES
  column deleted_at timestamp with time zone(timestamptz) nullable=YES
  column token_hash character varying(varchar) nullable=NO len=64
  column token_encrypted character varying(varchar) nullable=NO len=255
  column client_id character varying(varchar) nullable=NO len=255
  column user_id bigint(int8) nullable=NO precision=64 scale=0
  column app_id bigint(int8) nullable=YES precision=64 scale=0
  column scope character varying(varchar) nullable=YES len=255
  column expires_at timestamp with time zone(timestamptz) nullable=NO
TABLE analytics_events
  constraint analytics_events_pkey PRIMARY KEY (id)
  constraint fk_analytics_events_credential FOREIGN KEY (credential_id) REFERENCES credentials(id)
  constraint fk_apps_events FOREIGN KEY (app_id) REFERENCES apps(id)
  constraint fk_llms_events FOREIGN KEY (llm_id) REFERENCES llms(id)
  index CREATE UNIQUE INDEX analytics_events_pkey ON analytics_events USING btree (id)
  index CREATE INDEX idx_analytics_app ON analytics_events USING btree (app_id, created_at)
  index CREATE UNIQUE INDEX idx_analytics_events_request_id ON analytics_events USING btree (request_id)
