  index CREATE INDEX idx_analytics_timestamp ON analytics_events USING btree (time_stamp)
  index CREATE INDEX idx_analytics_user ON analytics_events USING btree (user_id)
  column id bigint(int8) nullable=NO precision=64 scale=0 default=nextval('analytics_events_id_seq'::regclass)
  column request_id text(text) nullable=NO
  column app_id bigint(int8) nullable=NO precision=64 scale=0
  column llm_id bigint(int8) nullable=YES precision=64 scale=0
  column credential_id bigint(int8) nullable=YES precision=64 scale=0
  column user_id bigint(int8) nullable=YES precision=64 scale=0
  column name text(text) nullable=YES
  column vendor text(text) nullable=YES
  column interaction_type text(text) nullable=YES default='proxy'::text
  column choices bigint(int8) nullable=YES precision=64 scale=0
  column tool_calls bigint(int8) nullable=YES precision=64 scale=0
  column chat_id text(text) nullable=YES
  column currency text(text) nullable=YES default='USD'::text
  column endpoint text(text) nullable=YES
  column method text(text) nullable=YES
  column status_code bigint(int8) nullable=YES precision=64 scale=0
  column prompt_tokens bigint(int8) nullable=YES precision=64 scale=0
  column response_tokens bigint(int8) nullable=YES precision=64 scale=0
  column total_tokens bigint(int8) nullable=YES precision=64 scale=0
  column cache_write_prompt_tokens bigint(int8) nullable=YES precision=64 scale=0
  column cache_read_prompt_tokens bigint(int8) nullable=YES precision=64 scale=0
  column cost numeric(numeric) nullable=YES
  column total_time_ms bigint(int8) nullable=YES precision=64 scale=0
  column error_message text(text) nullable=YES
  column metadata jsonb(jsonb) nullable=YES
  column request_body text(text) nullable=YES
  column response_body text(text) nullable=YES
  column router_kind text(text) nullable=YES
  column router_slug text(text) nullable=YES
  column router_pool_name text(text) nullable=YES
  column route text(text) nullable=YES
  column route_reason text(text) nullable=YES
  column router_source_model text(text) nullable=YES
  column router_target_model text(text) nullable=YES
  column router_selection_algo text(text) nullable=YES
  column route_score numeric(numeric) nullable=YES
  column shadow_route text(text) nullable=YES
  column on_behalf_of character varying(varchar) nullable=YES len=255
  column acting_agent character varying(varchar) nullable=YES len=255
  column failover_from_llm_id bigint(int8) nullable=YES precision=64 scale=0
  column failover_attempt bigint(int8) nullable=YES precision=64 scale=0 default=0
  column time_stamp timestamp with time zone(timestamptz) nullable=YES
  column created_at timestamp with time zone(timestamptz) nullable=YES
