# SMTP_SERVER=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=
ALLOW_REGISTRATIONS=true
ADMIN_EMAIL=you@tyk.io
SITE_URL=http://localhost:3000
FROM_EMAIL=noreply@tyk.io
DEVMODE=true
DATABASE_URL=midsommar.db
DATABASE_TYPE=sqlite

# ============================================================================
# Agent Call Tracing (Enterprise Edition)
# ============================================================================
# AGENT_TRACING_ENABLED=false
# Highest content mode any App, default or request header may capture
# (off|metadata|hashed|redacted|full). Left unset it resolves to metadata,
# which silently caps an App set to Redacted or Full. Apps still capture
# nothing until you set their own content mode (or the default below).
AGENT_TRACING_CONTENT_CEILING=redacted
# AGENT_TRACING_CONTENT_DEFAULT_MODE=off    # what Apps on "Inherit" capture
