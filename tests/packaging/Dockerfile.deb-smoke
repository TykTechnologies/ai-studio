FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a

ARG TARGETARCH=amd64

ENV DEBIAN_FRONTEND=noninteractive

# Install supervisor to manage both services (systemd doesn't work in Docker)
RUN apt-get update && \
    apt-get install -y --no-install-recommends supervisor curl ca-certificates bash && \
    rm -rf /var/lib/apt/lists/*

# Create tyk user/group (normally done by package preinstall script)
RUN groupadd -r tyk && useradd -r -g tyk -M -s /sbin/nologin -c "Tyk service user" tyk

# Install packages from local debs. dist/ holds one edition: CE packages are
# tyk-ai-studio_*.deb, ENT packages tyk-ai-studio-ee_*.deb, and each has a FIPS
# variant that is not under test here. Install exactly one package per
# component and fail the build if that is not possible, so a wrong name can
# never produce an image without binaries.
COPY dist/tyk-ai-studio*${TARGETARCH}.deb /tmp/
COPY dist/tyk-microgateway*${TARGETARCH}.deb /tmp/
RUN set -e; \
    rm -f /tmp/*fips*.deb; \
    for c in tyk-ai-studio tyk-microgateway; do \
      n=$(ls /tmp/${c}*_*${TARGETARCH}.deb | wc -l); \
      if [ "$n" -ne 1 ]; then echo "expected one ${c} package, found ${n}:"; ls /tmp; exit 1; fi; \
    done; \
    dpkg -i /tmp/tyk-ai-studio*_*${TARGETARCH}.deb /tmp/tyk-microgateway*_*${TARGETARCH}.deb; \
    rm -f /tmp/*.deb; \
    test -x /opt/tyk-ai-studio/tyk-ai-studio; \
    test -x /opt/tyk-microgateway/tyk-microgateway; \
    # The packaged edge default must load the analytics pulse from a file the
    # package ships; without it edges never report to the hub.
    grep -q '^PLUGINS_CONFIG_PATH=/opt/tyk-microgateway/config/analytics-pulse-config.yaml$' /etc/default/tyk-microgateway; \
    grep -q 'name: "analytics_pulse"' /opt/tyk-microgateway/config/analytics-pulse-config.yaml

# Overlay smoke test configs (matching auth tokens, SQLite, correct ports)
COPY tests/packaging/configs/tyk-ai-studio /etc/default/tyk-ai-studio
COPY tests/packaging/configs/tyk-microgateway /etc/default/tyk-microgateway

# Create data directories
RUN mkdir -p /opt/tyk-ai-studio/data /opt/tyk-microgateway/data && \
    chown -R tyk:tyk /opt/tyk-ai-studio /opt/tyk-microgateway

# Supervisor configuration
COPY tests/packaging/supervisord.conf /etc/supervisor/conf.d/tyk-services.conf

EXPOSE 8080 8081 8989 50051

HEALTHCHECK --interval=5s --timeout=5s --retries=30 \
    CMD curl -sf http://localhost:8080/health || exit 1

CMD ["supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
