# Runtime stage of ci/Dockerfile.microgateway.distroless, with a locally built
# binary. No analytics pulse config: the e2e gateway runs without it.
FROM gcr.io/distroless/base-debian12:nonroot@sha256:8b9f2e503e55aff85b79d6b22c7a63a65170e8698ae80de680e3f5ea600977bf

COPY tyk-microgateway /opt/tyk-microgateway/tyk-microgateway

WORKDIR /opt/tyk-microgateway/

ENTRYPOINT ["/opt/tyk-microgateway/tyk-microgateway"]
